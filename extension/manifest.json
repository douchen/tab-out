{
  "manifest_version": 3,
  "name": "Tab Out",
  "version": "1.0.0",
  "description": "管理你打开的标签页。用按域名分组的新标签页仪表盘，轻松查看、跳转、保存和关闭标签页。",
  "permissions": ["tabs", "activeTab", "storage"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Tab Out",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
